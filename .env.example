# Use the FastFlowLM service name and container port on a shared Docker network,
# or replace this with a reachable LAN address and port.
FASTFLOWLM_BASE_URL=http://fastflowlm:8000

# Host port for the chat UI.
FRONTEND_PORT=8080

# Loopback keeps the UI local. Set a host LAN address or 0.0.0.0 to expose it deliberately.
CHAT_BIND_ADDRESS=127.0.0.1
